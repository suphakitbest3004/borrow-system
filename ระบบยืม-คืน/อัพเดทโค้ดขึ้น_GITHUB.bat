@echo off
chcp 65001 >nul
title อัพเดทระบบขึ้น GitHub และ Vercel
color 0A

echo.
echo ===================================================
echo     กำลังนำโค้ดล่าสุดขึ้น GitHub และ Vercel...
echo ===================================================
echo.

cd /d "%~dp0"

echo [*] นำไฟล์ทั้งหมดเข้าคิว...
git add -A

echo [*] บันทึกการเปลี่ยนแปลง (Commit)...
git commit -m "อัพเดทระบบอัตโนมัติ"

echo [*] ดันโค้ดขึ้น GitHub (Push)...
git push origin main

echo.
echo ===================================================
echo   [OK] อัพเดทขึ้น GitHub สำเร็จเรียบร้อยแล้ว!
echo   Vercel กำลังนำขึ้นเว็บจริงให้อัตโนมัติ
echo ===================================================
echo.
echo หน้าต่างนี้จะปิดตัวเองใน 5 วินาที...
timeout /t 5 >nul
