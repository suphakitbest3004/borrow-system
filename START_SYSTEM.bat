@echo off
chcp 65001 >nul
title ระบบบริการยืม-คืนวัสดุและครุภัณฑ์ - วิทยาลัยการอาชีพหนองหาน
color 0B

echo.
echo ===================================================================
echo     ระบบบริการยืม-คืนวัสดุและครุภัณฑ์พร้อมการแจ้งเตือน
echo            วิทยาลัยการอาชีพหนองหาน จ.อุดรธานี
echo ===================================================================
echo.

cd /d "%~dp0"

echo [*] กำลังตรวจสอบความพร้อมของ Python...
python --version >nul 2>&1
if %errorlevel% neq 0 (
    color 0C
    echo [!] ไม่พบ Python ในเครื่อง กรุณาติดตั้ง Python ก่อนใช้งาน
    echo.
    pause
    exit /b
)

echo [*] กำลังเริ่มต้นเซิร์ฟเวอร์ระบบยืม-คืน (Flask Server)...
echo [*] กรุณารอสักครู่ ระบบกำลังเปิดหน้าเว็บไซต์ให้โดยอัตโนมัติ...
echo.

REM เปิดเบราว์เซอร์อัตโนมัติไปยังหน้าเว็บ
start "" http://127.0.0.1:5000

echo ===================================================================
echo  [OK] เซิร์ฟเวอร์กำลังทำงานเรียบร้อยแล้ว!
echo  - เปิดใช้งานบนเครื่องนี้:  http://127.0.0.1:5000
echo  - บัญชีทดสอบ:  admin@nonghan.ac.th / admin123 (มีปุ่ม 1-Click Login)
echo.
echo  *** อย่าปิดหน้าต่างนี้ขณะใช้งานระบบ (กดปิดเมื่อต้องการหยุดระบบ) ***
echo ===================================================================
echo.

python app.py

pause
